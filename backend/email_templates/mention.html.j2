{% extends "base.html.j2" %}

{% block body %}
<!-- Context strip -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:20px;background:#f6f8fb;border-radius:8px;padding:14px 16px;">
  <tr>
    <td style="padding:2px 0;">
      <div style="font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:#8892a4;margin-bottom:2px;">PO</div>
      <div style="font-size:14px;font-weight:600;color:#0b1220;">#{{ po_number }}</div>
    </td>
  </tr>
  {% if styles and styles|length > 1 %}
  <tr>
    <td style="padding:8px 0 2px 0;border-top:1px solid #e3e8f0;">
      <div style="font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:#8892a4;margin-bottom:6px;margin-top:8px;">Styles ({{ styles|length }})</div>
      <div style="font-size:12px;color:#0b1220;line-height:1.5;">
        {% for s in styles %}
        <div style="padding:4px 0;{% if not loop.last %}border-bottom:1px solid #eef1f5;{% endif %}">
          <strong>{{ s.style_code }}</strong>{% if s.colour %}<span style="color:#5b6577;"> · {{ s.colour }}</span>{% endif %}
          {% if s.description %}<div style="font-size:11px;color:#8892a4;margin-top:1px;">{{ s.description }}</div>{% endif %}
        </div>
        {% endfor %}
      </div>
    </td>
  </tr>
  {% elif style_code or colour or description %}
  <tr>
    <td style="padding:8px 0 2px 0;border-top:1px solid #e3e8f0;">
      <div style="font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:#8892a4;margin-bottom:2px;margin-top:8px;">Style</div>
      <div style="font-size:13px;color:#0b1220;">
        {% if style_code %}<strong>{{ style_code }}</strong>{% endif %}
        {% if colour %}<span style="color:#5b6577;"> · {{ colour }}</span>{% endif %}
        {% if description %}<div style="font-size:12px;color:#5b6577;margin-top:2px;">{{ description }}</div>{% endif %}
      </div>
    </td>
  </tr>
  {% endif %}
  {% if customer or factory %}
  <tr>
    <td style="padding:8px 0 0 0;border-top:1px solid #e3e8f0;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          {% if customer %}
          <td style="width:50%;vertical-align:top;">
            <div style="font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:#8892a4;margin-bottom:2px;margin-top:6px;">Customer</div>
            <div style="font-size:12px;color:#0b1220;">{{ customer }}</div>
          </td>
          {% endif %}
          {% if factory %}
          <td style="width:50%;vertical-align:top;">
            <div style="font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:#8892a4;margin-bottom:2px;margin-top:6px;">Factory</div>
            <div style="font-size:12px;color:#0b1220;">{{ factory }}</div>
          </td>
          {% endif %}
        </tr>
      </table>
    </td>
  </tr>
  {% endif %}
</table>

<!-- The comment -->
<div style="border-left:3px solid #2563eb;padding:2px 0 2px 14px;margin-bottom:8px;">
  <div style="font-size:12px;color:#5b6577;margin-bottom:6px;">
    <strong style="color:#0b1220;">{{ author_name }}</strong> wrote:
  </div>
  <div style="font-size:14px;line-height:1.6;color:#0b1220;white-space:pre-wrap;">{{ comment_text }}</div>
</div>
{% endblock %}
