# Database Configuration
DATABASE_URL=postgresql://orderbook:YOUR_SECURE_PASSWORD@db:5432/orderbook
POSTGRES_USER=orderbook
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD
POSTGRES_DB=orderbook

# Backend Security
# Generate with: openssl rand -hex 32
SECRET_KEY=YOUR_SECRET_KEY_HERE

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=https://sourcelab.truepathgroup.co.uk

# Frontend API Configuration
NEXT_PUBLIC_API_URL=https://sourcelab.truepathgroup.co.uk/api
NEXT_PUBLIC_WS_URL=wss://sourcelab.truepathgroup.co.uk/ws
